# GEMINI_API_KEY: Required for Gemini AI features
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted
APP_URL=

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=

# IKEEPAY KEYS
IKEEPAY_PUBLIC_KEY=your_public_key_here
IKEEPAY_PRIVATE_KEY=your_private_key_here
IKEEPAY_WEBHOOK_SECRET=your_webhook_secret_here

# SMTP EMAIL CONFIGURATION
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# INITIAL ADMIN SEED (Removed - use npm run create-admin command instead)
# ADMIN_INITIAL_EMAIL=
# ADMIN_INITIAL_PASSWORD=

# MONITORING & ERROR REPORTING (Optional)
SENTRY_DSN=

# LOCAL POSTGRESQL & CLOUD DATABASE CONNECTION
# Option 1: Full Database URL (e.g., local PostgreSQL instance or remote Postgres DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_builder_db

# Option 2: Individual SQL connection variables
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=cv_builder_db
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

